package com.tccs.engine;

import com.tccs.model.entity.Junction;
import com.tccs.model.entity.Signal;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;

import java.util.Comparator;
import java.util.List;

/**
 * ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 *  GREEDY SIGNAL OPTIMIZATION ALGORITHM
 * ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 *
 *  Strategy: At each step, allocate GREEN time
 *  proportionally to vehicle density.
 *  The lane with the highest density gets the
 *  most green time (GREEDY CHOICE).
 *
 *  Phase order is also greedy — busiest lane
 *  goes first in the cycle.
 * ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 */
@Component
@Slf4j
public class GreedySignalOptimizer {

    @Value("${traffic.signal.min-green-time:10}")
    private int minGreenTime;

    @Value("${traffic.signal.max-green-time:60}")
    private int maxGreenTime;

    @Value("${traffic.signal.yellow-time:3}")
    private int yellowTime;

    /**
     * Optimizes signal timings for a junction based on current densities.
     *
     * @param junction The junction to optimize
     * @return The list of signals with updated greenDuration and phaseOrder
     */
    public List<Signal> optimize(Junction junction) {
        List<Signal> signals = junction.getSignals();

        if (signals == null || signals.isEmpty()) {
            log.warn("No signals found for junction {}", junction.getJunctionCode());
            return signals;
        }

        int totalCycleTime = junction.getTotalCycleTime(); // e.g. 120s
        int numSignals = signals.size();
        int totalYellowTime = numSignals * yellowTime;
        int availableGreenTime = totalCycleTime - totalYellowTime;

        if (availableGreenTime <= 0) {
            log.error("Invalid cycle time for junction {}", junction.getJunctionCode());
            return signals;
        }

        // ─── Step 1: Calculate total density ───
        int totalDensity = signals.stream()
                .mapToInt(Signal::getVehicleDensity)
                .sum();

        // ─── Step 2: Sort by density DESCENDING (Greedy Choice) ───
        signals.sort(Comparator.comparingInt(Signal::getVehicleDensity).reversed());

        // ─── Step 3: Allocate green time ───
        if (totalDensity == 0) {
            // Equal distribution when no traffic data
            int equalGreen = availableGreenTime / numSignals;
            for (Signal signal : signals) {
                signal.setGreenDuration(equalGreen);
                signal.setYellowDuration(yellowTime);
            }
        } else {
            int allocatedTime = 0;

            for (int i = 0; i < signals.size(); i++) {
                Signal signal = signals.get(i);
                double proportion = (double) signal.getVehicleDensity() / totalDensity;
                int greenTime = (int) Math.round(proportion * availableGreenTime);

                // Clamp within bounds
                greenTime = Math.max(minGreenTime, Math.min(maxGreenTime, greenTime));

                // Last signal gets remaining time
                if (i == signals.size() - 1) {
                    greenTime = availableGreenTime - allocatedTime;
                    greenTime = Math.max(minGreenTime, greenTime);
                }

                signal.setGreenDuration(greenTime);
                signal.setYellowDuration(yellowTime);
                allocatedTime += greenTime;
            }

            // ─── Step 4: Adjust if over-allocated ───
            if (allocatedTime > availableGreenTime) {
                int excess = allocatedTime - availableGreenTime;
                // Remove excess from the least dense signal
                Signal leastDense = signals.get(signals.size() - 1);
                int adjusted = Math.max(minGreenTime,
                        leastDense.getGreenDuration() - excess);
                leastDense.setGreenDuration(adjusted);
            }
        }

        // ─── Step 5: Set phase order (busiest first = greedy) ───
        for (int i = 0; i < signals.size(); i++) {
            signals.get(i).setPhaseOrder(i);
        }

        // ─── Step 6: Calculate red duration for each signal ───
        for (Signal signal : signals) {
            int otherGreenTime = signals.stream()
                    .filter(s -> !s.getId().equals(signal.getId()))
                    .mapToInt(s -> s.getGreenDuration() + s.getYellowDuration())
                    .sum();
            signal.setRedDuration(otherGreenTime);
        }

        log.info("Optimized junction {} — densities: {}, greens: {}",
                junction.getJunctionCode(),
                signals.stream().map(s -> s.getDirection() + "=" +
                        s.getVehicleDensity()).toList(),
                signals.stream().map(s -> s.getDirection() + "=" +
                        s.getGreenDuration() + "s").toList());

        return signals;
    }
}