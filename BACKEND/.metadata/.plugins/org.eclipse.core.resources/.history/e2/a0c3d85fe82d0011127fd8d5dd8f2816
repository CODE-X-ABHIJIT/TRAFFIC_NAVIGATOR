package com.tccs.service;

import java.util.List;

import org.springframework.messaging.simp.SimpMessagingTemplate;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import com.tccs.engine.GreedySignalOptimizer;
import com.tccs.exception.ResourceNotFoundException;
import com.tccs.model.dto.SignalOverrideRequest;
import com.tccs.model.entity.Junction;
import com.tccs.model.entity.Signal;
import com.tccs.model.enums.ControlMode;
import com.tccs.model.enums.SignalState;
import com.tccs.repository.JunctionRepository;
import com.tccs.repository.SignalRepository;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@Service
@RequiredArgsConstructor
@Slf4j
public class SignalControlService {

    private final JunctionRepository junctionRepository;
    private final SignalRepository signalRepository;
    private final GreedySignalOptimizer optimizer;
    private final SimpMessagingTemplate messagingTemplate;

    /**
     * Manual signal override by officer.
     */
    @Transactional
    public void overrideSignal(SignalOverrideRequest request) {
        Junction junction = findJunction(request.getJunctionCode());

        // Switch to manual mode
        junction.setControlMode(ControlMode.MANUAL);
        junctionRepository.save(junction);

        if ("ALL".equalsIgnoreCase(request.getDirection())) {
            // Set ALL signals to same state (e.g., ALL RED for emergency)
            for (Signal signal : junction.getSignals()) {
                signal.setCurrentState(request.getState());
                signal.setCountdownSeconds(
                        request.getDurationSeconds() != null
                                ? request.getDurationSeconds() : 0);
            }
        } else {
            // Set specific direction
            Signal signal = signalRepository.findByJunctionCodeAndDirection(
                    request.getJunctionCode(), request.getDirection().toUpperCase())
                    .orElseThrow(() -> new ResourceNotFoundException(
                            "Signal not found: " + request.getDirection()));

            signal.setCurrentState(request.getState());
            signal.setCountdownSeconds(
                    request.getDurationSeconds() != null
                            ? request.getDurationSeconds()
                            : signal.getGreenDuration());

            // If setting one to GREEN, set others to RED
            if (request.getState() == SignalState.GREEN) {
                for (Signal s : junction.getSignals()) {
                    if (!s.getId().equals(signal.getId())) {
                        s.setCurrentState(SignalState.RED);
                        s.setCountdownSeconds(0);
                    }
                }
            }
        }

        signalRepository.saveAll(junction.getSignals());
        log.info("Manual override: {} - {} → {} by reason: {}",
                request.getJunctionCode(), request.getDirection(),
                request.getState(), request.getReason());

        // Broadcast change
        messagingTemplate.convertAndSend("/topic/signal-override",
                "Override applied at " + request.getJunctionCode());
    }

    /**
     * Switch junction between AUTO and MANUAL mode.
     */
    @Transactional
    public void setControlMode(String junctionCode, ControlMode mode) {
        Junction junction = findJunction(junctionCode);
        junction.setControlMode(mode);
        junctionRepository.save(junction);

        if (mode == ControlMode.AUTO) {
            // Trigger optimization when switching back to auto
            optimizeJunction(junctionCode);
        }

        log.info("Junction {} mode changed to {}", junctionCode, mode);
    }

    /**
     * Emergency clearance — all signals red except specified direction.
     */
    @Transactional
    public void emergencyClearance(String junctionCode, String clearDirection) {
        Junction junction = findJunction(junctionCode);
        junction.setControlMode(ControlMode.MANUAL);
        junctionRepository.save(junction);

        for (Signal signal : junction.getSignals()) {
            if (signal.getDirection().equalsIgnoreCase(clearDirection)) {
                signal.setCurrentState(SignalState.GREEN);
                signal.setCountdownSeconds(60); // 60s emergency green
            } else {
                signal.setCurrentState(SignalState.RED);
                signal.setCountdownSeconds(60);
            }
        }

        signalRepository.saveAll(junction.getSignals());
        log.info("EMERGENCY CLEARANCE: {} direction {} cleared",
                junctionCode, clearDirection);

        messagingTemplate.convertAndSend("/topic/alerts",
                "🚨 Emergency clearance at " + junctionCode +
                " — " + clearDirection + " lane cleared");
    }

    /**
     * Runs the greedy optimizer for a specific junction.
     */
    @Transactional
    public void optimizeJunction(String junctionCode) {
        Junction junction = findJunction(junctionCode);

        if (junction.getControlMode() == ControlMode.MANUAL) {
            log.info("Skipping optimization for {} (MANUAL mode)", junctionCode);
            return;
        }

        List<Signal> optimized = optimizer.optimize(junction);
        signalRepository.saveAll(optimized);
        log.debug("Junction {} optimized", junctionCode);
    }

    /**
     * Runs the optimizer for ALL AUTO-mode junctions.
     */
    @Transactional
    public void optimizeAllJunctions() {
        List<Junction> autoJunctions =
                junctionRepository.findByControlMode(ControlMode.AUTO);

        for (Junction junction : autoJunctions) {
            optimizer.optimize(junction);
            signalRepository.saveAll(junction.getSignals());
        }

        log.info("Optimized {} AUTO-mode junctions", autoJunctions.size());
    }

    /**
     * Gets the current control mode of a junction.
     */
    public ControlMode getControlMode(String junctionCode) {
        return findJunction(junctionCode).getControlMode();
    }

    private Junction findJunction(String code) {
        return junctionRepository.findByJunctionCode(code)
                .orElseThrow(() -> new ResourceNotFoundException(
                        "Junction not found: " + code));
    }
}