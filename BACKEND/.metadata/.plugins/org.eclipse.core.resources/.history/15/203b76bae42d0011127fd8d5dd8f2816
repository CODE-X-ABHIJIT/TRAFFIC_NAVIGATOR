ackage com.tccs.model.entity;

import com.fasterxml.jackson.annotation.JsonIgnore;
import com.tccs.model.enums.SignalState;
import jakarta.persistence.*;
import lombok.*;
import java.time.LocalDateTime;

@Entity
@Table(name = "signals")
@Getter @Setter
@NoArgsConstructor @AllArgsConstructor
@Builder
public class Signal {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "junction_id", nullable = false)
    @JsonIgnore
    private Junction junction;

    @Column(nullable = false, length = 10)
    private String direction;  // NORTH, SOUTH, EAST, WEST

    @Enumerated(EnumType.STRING)
    @Column(name = "current_state", nullable = false)
    @Builder.Default
    private SignalState currentState = SignalState.RED;

    @Column(name = "green_duration")
    @Builder.Default
    private int greenDuration = 30;  // seconds — set by optimizer

    @Column(name = "yellow_duration")
    @Builder.Default
    private int yellowDuration = 3;

    @Column(name = "red_duration")
    @Builder.Default
    private int redDuration = 87; // computed from cycle

    @Column(name = "countdown_seconds")
    @Builder.Default
    private int countdownSeconds = 0;

    @Column(name = "vehicle_density")
    @Builder.Default
    private int vehicleDensity = 0;  // vehicles detected

    @Column(name = "vehicle_speed")
    @Builder.Default
    private double vehicleSpeed = 0.0;  // km/h

    @Column(name = "free_flow_speed")
    @Builder.Default
    private double freeFlowSpeed = 60.0; // km/h

    @Column(name = "phase_order")
    @Builder.Default
    private int phaseOrder = 0; // 0,1,2,3 — sequence in cycle

    @Column(name = "last_updated")
    private LocalDateTime lastUpdated;

    @PrePersist
    @PreUpdate
    protected void onUpdate() {
        lastUpdated = LocalDateTime.now();
    }
}