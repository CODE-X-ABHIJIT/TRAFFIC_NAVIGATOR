package com.tccs.integration;

import com.tccs.model.dto.TrafficFlowData;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;
import org.springframework.web.client.RestTemplate;

import java.util.Map;
import java.util.Random;

/**
 * Fetches real-time traffic data from TomTom Traffic Flow API.
 * Falls back to simulation when API key is not configured.
 */
@Component
@Slf4j
public class TomTomTrafficClient {

    private final RestTemplate restTemplate;
    private final Random random = new Random();

    @Value("${traffic.tomtom.api-key}")
    private String apiKey;

    @Value("${traffic.tomtom.base-url}")
    private String baseUrl;

    @Value("${traffic.simulation.enabled:true}")
    private boolean simulationEnabled;

    public TomTomTrafficClient(RestTemplate restTemplate) {
        this.restTemplate = restTemplate;
    }

    /**
     * Gets traffic flow data for a geographic point.
     */
    public TrafficFlowData getTrafficFlow(double latitude, double longitude) {
        // Use simulation if enabled or API key not set
        if (simulationEnabled || "YOUR_TOMTOM_API_KEY".equals(apiKey)) {
            return simulateTrafficData(latitude, longitude);
        }

        try {
            String url = String.format("%s?point=%f,%f&key=%s",
                    baseUrl, latitude, longitude, apiKey);

            @SuppressWarnings("unchecked")
            Map<String, Object> response = restTemplate.getForObject(url, Map.class);

            if (response != null && response.containsKey("flowSegmentData")) {
                @SuppressWarnings("unchecked")
                Map<String, Object> flowData =
                        (Map<String, Object>) response.get("flowSegmentData");

                return TrafficFlowData.builder()
                        .currentSpeed(toDouble(flowData.get("currentSpeed")))
                        .freeFlowSpeed(toDouble(flowData.get("freeFlowSpeed")))
                        .currentTravelTime(toDouble(flowData.get("currentTravelTime")))
                        .freeFlowTravelTime(toDouble(flowData.get("freeFlowTravelTime")))
                        .confidence(toDouble(flowData.get("confidence")))
                        .roadClosure(toInt(flowData.get("roadClosure")))
                        .build();
            }
        } catch (Exception e) {
            log.warn("TomTom API call failed for ({}, {}): {}. Using simulation.",
                    latitude, longitude, e.getMessage());
        }

        return simulateTrafficData(latitude, longitude);
    }

    /**
     * Simulates realistic traffic data when API is unavailable.
     */
    private TrafficFlowData simulateTrafficData(double lat, double lon) {
        // Generate time-based variation (busier during "peak hours")
        int hour = java.time.LocalTime.now().getHour();
        double peakFactor = isPeakHour(hour) ? 0.6 : 0.85;

        double freeFlow = 40 + random.nextInt(30);          // 40–70 km/h
        double variation = peakFactor + (random.nextDouble() * 0.3 - 0.15);
        double currentSpeed = freeFlow * Math.max(0.1, Math.min(1.0, variation));

        return TrafficFlowData.builder()
                .currentSpeed(Math.round(currentSpeed * 10.0) / 10.0)
                .freeFlowSpeed(freeFlow)
                .currentTravelTime(120 + random.nextInt(180))
                .freeFlowTravelTime(60 + random.nextInt(60))
                .confidence(0.7 + random.nextDouble() * 0.3)
                .roadClosure(0)
                .build();
    }

    private boolean isPeakHour(int hour) {
        return (hour >= 8 && hour <= 10) || (hour >= 17 && hour <= 20);
    }

    private double toDouble(Object val) {
        if (val instanceof Number) return ((Number) val).doubleValue();
        return 0.0;
    }

    private int toInt(Object val) {
        if (val instanceof Number) return ((Number) val).intValue();
        return 0;
    }
}